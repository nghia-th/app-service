# Template for config/secrets.yaml (gitignored, not committed).
#
# Setup: copy this file to "secrets.yaml" (hoặc "secrets-dev.yaml", "secrets-prod.yaml" theo profile)
#   cp config/secrets.yaml.example config/secrets.yaml
#   cp config/secrets.yaml.example config/secrets-dev.yaml
#
# application.yaml imports config/secrets.yaml và config/secrets-${spring.profiles.active}.yaml
# (optional, so the app still boots against the default SQLITE engine - which needs no datasource
# credentials - even without this file). Values here override the placeholder defaults in application.yaml.
spring:
  datasource:
    # Only used when base.database.type is POSTGRESQL/MYSQL/SQLSERVER/ORACLE (SQLITE ignores these).
    username: postgres
    password: change-me

quiz:
  jwt:
    # Must be 32+ bytes for HMAC-SHA256. Generate a real random secret per environment - never
    # reuse the dev placeholder from application.yaml outside local development.
    secret: "change-me-to-a-real-random-secret-32bytes-min"
